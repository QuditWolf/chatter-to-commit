# Copy to .env and fill in values:  cp .env.example .env

# Path to the shared SQLite database (relative to wa_listener/)
FLEET_DB_PATH=../data/fleet.db

# WhatsApp group JID — leave blank on first run to discover it
# Start listener, send a message to your group, copy the logged JID here
WA_GROUP_JID=

# Log level: silent | info | debug
LOG_LEVEL=info
