# ── External port ──────────────────────────────────────────────────────────────
# The port exposed on the host. Change to any free port (80, 3000, 9000, etc.)
HOST_PORT=8080

# ── LLM endpoint ───────────────────────────────────────────────────────────────
# Point to your LLM server. From inside Docker:
#   - If LLM runs on the same host:  http://host.docker.internal:8001/v1  (Mac/Win)
#                                    http://172.17.0.1:8001/v1             (Linux)
#   - If LLM runs on another server: http://192.168.1.x:8001/v1
#   - Ollama:                        http://host.docker.internal:11434/v1
#   - Mock mode (no LLM):            set FLEET_LLM_MOCK=true
FLEET_LLM_BASE_URL=http://host.docker.internal:8001/v1
FLEET_LLM_API_KEY=EMPTY
# Model alias as set with --alias in llama-server, or the vLLM model name
FLEET_MODEL=qwen3.5-9b
# For thinking models (Qwen3, GLM) set >=4096 to leave room after thinking tokens.
# For non-thinking models (Qwen2.5-7B etc.) 1024 is sufficient.
FLEET_LLM_MAX_TOKENS=4096
FLEET_LLM_TIMEOUT=120
FLEET_LLM_TEMPERATURE=0.1
FLEET_LLM_MOCK=false

# ── WhatsApp ────────────────────────────────────────────────────────────────────
# Get the group JID: run `docker compose logs -f wa` after scanning QR,
# then send any message to the group — the JID is logged.
# Format: 120363XXXXXXXXXX@g.us
WA_GROUP_JID=

# ── Auth ────────────────────────────────────────────────────────────────────────
# Password to access the dashboard and all APIs.
# Leave blank to disable auth (dev/local use only).
FLEET_AUTH_PASSWORD=changeme

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
