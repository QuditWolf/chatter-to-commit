# ── External port ──────────────────────────────────────────────────────────────
# The port exposed on the host. Change to any free port (80, 3000, 9000, etc.)
HOST_PORT=8080

# ── LLM endpoint ───────────────────────────────────────────────────────────────
# Point to your LLM server. From inside Docker:
#   - If LLM runs on the same host:  http://host.docker.internal:8001/v1  (Mac/Win)
#                                    http://172.17.0.1:8001/v1             (Linux)
#   - If LLM runs on another server: http://192.168.1.x:8001/v1
#   - Ollama:                        http://host.docker.internal:11434/v1
#   - Mock mode (no LLM):            set FLEET_LLM_MOCK=true
FLEET_LLM_BASE_URL=http://host.docker.internal:8001/v1
FLEET_LLM_API_KEY=EMPTY
# Model name — must match the filename loaded by llama-server
# Current: Qwen2.5-32B-Instruct-Q4_K_M.gguf
FLEET_MODEL=Qwen2.5-32B-Instruct-Q4_K_M.gguf
# Max tokens — must be <= llama-server's -n flag (default 1200)
# Qwen2.5-32B: 1200 is sufficient; higher causes hallucination loops
FLEET_LLM_MAX_TOKENS=1200
FLEET_LLM_TIMEOUT=120
FLEET_LLM_TEMPERATURE=0.1
FLEET_LLM_MOCK=false

# ── WhatsApp ────────────────────────────────────────────────────────────────────
# Fleet group (READ-ONLY): truck movement messages are ingested from here.
# NEVER send any bot messages to this group.
# Format: 120363XXXXXXXXXX@g.us
WA_GROUP_JID=

# Control group: shift start/end signals (with site) come from here.
# Bot HITL questions, acknowledgements, and periodic summaries are sent here.
# Leave empty to fall back to single-group mode (old behaviour).
WA_CONTROL_GROUP_JID=

# ── Auth ────────────────────────────────────────────────────────────────────────
# Password to access the dashboard and all APIs.
# Leave blank to disable auth (dev/local use only).
FLEET_AUTH_PASSWORD=changeme

# ── Logging ────────────────────────────────────────────────────────────────────
LOG_LEVEL=info
